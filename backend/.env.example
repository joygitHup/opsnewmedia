# ===== 基础 =====
DJANGO_SETTINGS_MODULE=config.settings.dev
ENV=dev
SECRET_KEY=please-replace-with-strong-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.dev.coze.site

# ===== 数据库 (PostgreSQL) =====
DATABASE_URL=postgres://opsnewmedia:opsnewmedia@127.0.0.1:5432/opsnewmedia
# 库名：opsnewmedia，需在已运行的 PG 容器内手动 CREATE DATABASE

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# ===== Celery / RabbitMQ =====
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ===== MinIO (对象存储) =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET=opsnewmedia

# ===== 平台 Token 加密密钥 (32 字节 base64 或 hex) =====
# 用于 AES-GCM 加密各平台 access_token / refresh_token 落库
PLATFORM_TOKEN_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== JWT =====
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# ===== CORS 白名单 =====
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ===== 微信公众号 =====
WECHAT_MP_APPID=your_appid
WECHAT_MP_SECRET=your_secret

# ===== 小红书 =====
XIAOHONGSHU_APP_ID=your_app_id
XIAOHONGSHU_APP_SECRET=your_app_secret

# ===== AI (OpenAI 兼容) =====
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=your-key
AI_MODEL=gpt-4o-mini
